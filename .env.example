# ==============================================================================
# RunRanger Runtime Configuration
# 
# ZERO PAID APIS REQUIRED:
# RunRanger does NOT require or accept OpenAI, Gemini, Anthropic, or paid map keys.
# All settings below have sensible local defaults and work completely out of the box.
# ==============================================================================

# Ollama local inference endpoint (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Open-weight local model name (default: gemma3:4b)
OLLAMA_MODEL=gemma3:4b

# Ollama inference timeout in seconds
OLLAMA_TIMEOUT_S=120

# Local SQLite database path (stored on your device)
RUNRANGER_DB=./data/runranger.db

# Open routing service (default: public OSRM demonstration server)
# Note: For 100% offline usage, local geometric loop routing is used automatically.
OSRM_URL=https://router.project-osrm.org

# Allowed CORS origins for frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
